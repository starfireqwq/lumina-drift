{
  "name": "atelier-sync",
  "version": "1.3.1",
  "license": "MIT",
  "private": true,
  "description": "AtelierSync - Private multi-user real-time collaborative drawing software",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@atelier/*\" dev",
    "dev:server": "pnpm --filter @atelier/server dev",
    "dev:client": "pnpm --filter @atelier/client dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @atelier/server test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "ag-psd": "^34.1.0",
    "jszip": "^3.10.2"
  }
}
